# Snakefile (part 06, module 01): read QC and trimming, the Snakemake version of run_qc.sh
#   raw/ --fastqc_raw--> qc/fastqc_raw/ ---------------------------\
#   raw/ --fastp--> qc/trimmed/ --fastqc_trimmed--> qc/fastqc_trimmed/ --multiqc--> qc/multiqc/
#                   qc/fastp/  -------------------------------------/
# Copy this Snakefile and config.yaml into your project folder (cd ~/meta), then:
#   snakemake -n ; snakemake -c 4

configfile: "config.yaml"

SAMPLES = config["samples"]
READS = ["R1", "R2"]


rule all:
    input:
        "qc/multiqc/multiqc_report.html",


rule fastqc_raw:
    input:
        "raw/{sample}_{read}.fastq.gz",
    output:
        html="qc/fastqc_raw/{sample}_{read}_fastqc.html",
        zip="qc/fastqc_raw/{sample}_{read}_fastqc.zip",
    log:
        "logs/fastqc_raw/{sample}_{read}.log",
    shell:
        "fastqc -q -o qc/fastqc_raw {input} > {log} 2>&1"


rule fastp:
    input:
        r1="raw/{sample}_R1.fastq.gz",
        r2="raw/{sample}_R2.fastq.gz",
    output:
        r1="qc/trimmed/{sample}_R1.fastq.gz",
        r2="qc/trimmed/{sample}_R2.fastq.gz",
        json="qc/fastp/{sample}.json",
        html="qc/fastp/{sample}.html",
    params:
        q=config["cut_mean_quality"],
        l=config["length_required"],
    threads: 4
    log:
        "logs/fastp/{sample}.log",
    shell:
        "fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} "
        "--detect_adapter_for_pe --cut_front --cut_tail --cut_mean_quality {params.q} "
        "--length_required {params.l} --thread {threads} "
        "-j {output.json} -h {output.html} > {log} 2>&1"


rule fastqc_trimmed:
    input:
        "qc/trimmed/{sample}_{read}.fastq.gz",
    output:
        html="qc/fastqc_trimmed/{sample}_{read}_fastqc.html",
        zip="qc/fastqc_trimmed/{sample}_{read}_fastqc.zip",
    log:
        "logs/fastqc_trimmed/{sample}_{read}.log",
    shell:
        "fastqc -q -o qc/fastqc_trimmed {input} > {log} 2>&1"


rule multiqc:
    input:
        expand("qc/fastqc_raw/{sample}_{read}_fastqc.zip", sample=SAMPLES, read=READS),
        expand("qc/fastqc_trimmed/{sample}_{read}_fastqc.zip", sample=SAMPLES, read=READS),
        expand("qc/fastp/{sample}.json", sample=SAMPLES),
    output:
        "qc/multiqc/multiqc_report.html",
    log:
        "logs/multiqc.log",
    shell:
        "multiqc -q -f -o qc/multiqc {input} > {log} 2>&1"
